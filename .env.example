# =============================================================================
# Airflow 3.1.6 Public Data Platform - Environment Configuration (Example)
# =============================================================================

# Airflow User ID (for volume permissions)
AIRFLOW_UID=50000

# Airflow Admin Credentials (for initial login)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# FERNET_KEY - CRITICAL for encrypting Variables/Connections
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=Z6V0Y_OA9CVAY1OKBi3kXlL13eO7ZdTf-7HSjjDJgpA=

# MinIO Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Redis Password
REDIS_PASSWORD=redis123

# Grafana Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ANONYMOUS_ENABLED=true

# JWT Secret for API authentication (generate with: openssl rand -base64 32)
AIRFLOW__API_AUTH__JWT_SECRET=Kx7mN2pQ9vR4wE6yT8uI3oP5aS1dF0gH7jK9lZ2xC4vB

# PostgreSQL (for data warehouse access from host)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# dbt environment
DBT_ENV=dev
